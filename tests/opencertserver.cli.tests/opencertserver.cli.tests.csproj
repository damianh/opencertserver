<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <RootNamespace>opencertserver.cli.tests</RootNamespace>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <OutputType>exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.TestHost"/>
        <PackageReference Include="Reqnroll.xUnit.v3"/>
        <PackageReference Include="xunit.v3.mtp-v2"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/opencertserver.cli/opencertserver.cli.csproj"/>
        <ProjectReference Include="../../src/opencertserver.ca/opencertserver.ca.csproj"/>
        <ProjectReference Include="../../src/opencertserver.ca.server/opencertserver.ca.server.csproj"/>
        <ProjectReference Include="../../src/opencertserver.ca.utils/opencertserver.ca.utils.csproj"/>
        <ProjectReference Include="../../src/opencertserver.est.server/opencertserver.est.server.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="test.crt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="ca.key">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="ca.crt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="test.csr">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
